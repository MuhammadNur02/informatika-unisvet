# Salin file ini jadi ".env" lalu isi setiap nilai dengan kredensial project
# Supabase kamu sendiri (Project Settings -> API di dashboard Supabase).
# JANGAN PERNAH commit file ".env" (yang berisi nilai asli) ke git — hanya
# file ".env.example" ini (isinya kosong/placeholder) yang boleh ikut di-push.

# URL & Project ID project Supabase kamu
SUPABASE_URL=
SUPABASE_PROJECT_ID=

# Kunci PUBLIK (anon/publishable) — aman dibagikan ke client/browser,
# asalkan Row Level Security di setiap tabel sudah dikonfigurasi dengan benar.
SUPABASE_PUBLISHABLE_KEY=

# Kunci RAHASIA — JANGAN PERNAH dipakai di kode sisi client/browser, dan
# jangan dibagikan ke siapa pun di luar tim tepercaya. Kunci ini melewati
# (bypass) semua aturan Row Level Security.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Salinan untuk Vite (wajib prefix VITE_ supaya ikut ke-bundle ke client) —
# HANYA isi dengan kunci PUBLIK yang sama seperti di atas, jangan pernah
# taruh SECRET_KEY/SERVICE_ROLE_KEY di variabel berprefix VITE_.
VITE_SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=
